# Copy to `.env` for local API (never commit `.env`). The API loads it via dotenv (`server.js`).
# After filling SMTP_*, run: npm run email:test
# On Vercel: Project → Settings → Environment Variables (same names; no .env file).

# --- Email: Microsoft 365 / Outlook (recommended for Teams calendar invite + cancel) ---
# SMTP_SERVICE=office365
# SMTP_USER=you@yourcompany.com
# SMTP_PASS=your-work-password-or-app-password
# SMTP_FROM=you@yourcompany.com
# (host/port are applied automatically: smtp.office365.com:587)

# --- Email: Gmail (use an App Password, not your normal Gmail password) ---
# 1. Google Account → Security → 2-Step Verification ON
# 2. Security → App passwords → create "Mail" → copy the 16-character password
# 3. Fill SMTP_USER / SMTP_PASS / SMTP_FROM with your Gmail address
SMTP_SERVICE=gmail
SMTP_USER=youraddress@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=youraddress@gmail.com

# Optional: link in emails (Open calendar button)
# APP_URL=http://localhost:5173

# --- Email: other SMTP (omit SMTP_SERVICE and use these instead) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com

# --- Database (production) ---
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# JWT Secret (Settings → API) — server-only; attached to /api/auth/me for Realtime RLS
# SUPABASE_JWT_SECRET=
# Database password (Settings → Database) — used by npm run db:migrate
# SUPABASE_DB_PASSWORD=your-database-password
# Optional pooler host if not ap-southeast-1: SUPABASE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# Or full URI: SUPABASE_DB_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# --- Frontend Realtime (Vite build / Vercel env — public anon key only) ---
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...   # Project Settings → API → anon public (never service_role)

# --- Observability (optional) ---
# SENTRY_DSN=https://...@o....ingest.sentry.io/...
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.05
# LOG_LEVEL=info

# --- Local dev only (file-backed store; not for production) ---
# ALLOW_LOCAL_STORE=1
